{:paths ["src"]
 :deps {
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; the itonami actor pattern's governor layer, written once —
        ;; the four rules and the verdict assembly every actor shares.
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/governor.git"
         :git/sha "90a2944e617e58b9c90314b7e84b003ec3ea0c1f"}
        ;; what a tax record must carry, by jurisdiction.
        ;;
        ;; A GIT dep, not a sibling path. Measured 2026-08-17: taxlaw has no
        ;; :local/root deps of its own, so it is consumable as one -- and
        ;; that is what makes this repo forkable for real (its README claims
        ;; "forkable by any qualified operator", which a sibling path
        ;; quietly makes false) and gateable on the murakumo fleet, which
        ;; ships one repo's tree and no siblings.
        io.github.kotoba-lang/taxlaw
        {:git/url "https://github.com/kotoba-lang/taxlaw.git"
         :git/sha "718b09ea4fd608dc3a12d0baaa095588046a2e5c"}
        ;; the double-entry contract this workspace already has. kakeibo
        ;; projects personal statement rows onto it; bookkeeping.posting
        ;; projects journal entries onto the same thing, so an approved
        ;; entry has a destination and balance is checked in one place.
        io.github.kotoba-lang/banking
        {:git/url "https://github.com/kotoba-lang/banking.git"
         :git/sha "b8750ad17d16c012c7de62d4bf785973464495cc"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; clojure -M:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300, ISCO cluster).
  :render-html {:main-opts ["-m" "bookkeeping.render-html"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
