        ;; that is what makes this repo forkable for real (its README claims
        ;; "forkable by any qualified operator", which a sibling path
        ;; quietly makes false) and gateable on the murakumo fleet, which
        ;; ships one repo's tree and no siblings.
        io.github.kotoba-lang/taxlaw
        {:git/url "https://github.com/kotoba-lang/taxlaw.git"
         :git/sha "ad431b4f8a07474e2c0b8f4bf2efba3fca3e03f1"}
