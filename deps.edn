{:paths ["src"]
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}
io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.langgraph"}
        ;; the itonami actor pattern's governor layer, written once —
        ;; the four rules and the verdict assembly every actor shares.
        io.github.kotoba-lang/governor
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.governor"}
        ;; what a tax record must carry, by jurisdiction.
        ;;
        ;; A GIT dep, not a sibling path. Measured 2026-08-17: taxlaw has no
        ;; :local/root deps of its own, so it is consumable as one -- and
        ;; that is what makes this repo forkable for real (its README claims
        ;; "forkable by any qualified operator", which a sibling path
        ;; quietly makes false) and gateable on the murakumo fleet, which
        ;; ships one repo's tree and no siblings.
        io.github.kotoba-lang/taxlaw
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.taxlaw"}
        ;; the double-entry contract this workspace already has. kakeibo
        ;; projects personal statement rows onto it; bookkeeping.posting
        ;; projects journal entries onto the same thing, so an approved
        ;; entry has a destination and balance is checked in one place.
        io.github.kotoba-lang/banking
        {:git/url "https://github.com/kotoba-lang/banking.git"
         :git/sha "b8750ad17d16c012c7de62d4bf785973464495cc"}
        ;; CACAO verification for the edge surface. The shared library --
        ;; signature and temporal window are not reimplemented here
        ;; (ADR-2607268000).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/org.chainagnostic.cacao"}
        ;; the durable store backend. Its codec (blob-lookup / put-blob! /
        ;; read-stream / append-blob!) is not hand-rolled here.
        io.github.kotoba-lang/langchain-store
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.langchainStore"}
        ;; 諸表 — the trial balance folded into 貸借対照表 / 損益計算書, and
        ;; the 会社計算規則 区分. It refuses to guess what an account is, so
        ;; the chart is registered per client rather than defaulted.
        io.github.kotoba-lang/shohyo
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "8c5b1bdafd70de1a36d2a6c3e1b71d415727225d"
         :deps/root "lib/kotoba.shohyo"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test"] :main-opts ["-m" "cognitect.test-runner"]}
:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  ;; kbb -M:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300, ISCO cluster).
  :render-html {:main-opts ["-m" "bookkeeping.render-html"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
